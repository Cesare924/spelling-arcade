{
  "expo": {
    "name": "Spelling Stars",
    "slug": "spelling-stars",
    "scheme": "spellingstars",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.cesare924.spellingstars",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cesare924.spellingstars",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundImage": "./assets/icon/adaptive-background.png",
        "backgroundColor": "#5b21b6"
      },
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/splash.png",
          "imageWidth": 240,
          "backgroundColor": "#6d28d9"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Spelling Stars uses the camera to scan your spelling list. The photo is read on this phone and is not uploaded.",
          "photosPermission": "Spelling Stars can read a spelling list from a photo you choose. The photo is read on this phone and is not uploaded.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-short-native-build.js"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon/icon.png"
  }
}
