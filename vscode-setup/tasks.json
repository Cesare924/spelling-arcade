{
  // Run any of these from Terminal > Run Task (or Ctrl+Shift+B for the build).

  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start emulator",
      "detail": "Starts the Android emulator in its most stable mode. Leave it running.",
      "type": "shell",
      "command": "emulator -avd Medium_Phone_API_37.0 -no-snapshot-load -gpu swiftshader_indirect",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    {
      "label": "Check Android connection",
      "detail": "Lists connected phones and emulators. Look for 'device' next to the name.",
      "type": "shell",
      "command": "adb devices",
      "problemMatcher": [],
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    {
      "label": "Pair phone over Wi-Fi",
      "detail": "One time per phone. On the phone: Wireless debugging > Pair device with pairing code.",
      "type": "shell",
      "command": "adb pair ${input:pairAddress} ${input:pairCode}",
      "problemMatcher": [],
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    {
      "label": "Connect phone over Wi-Fi",
      "detail": "Use the IP address & Port shown at the top of the phone's Wireless debugging screen.",
      "type": "shell",
      "command": "adb connect ${input:connectAddress}; adb devices",
      "problemMatcher": [],
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    {
      "label": "Build & install on Android",
      "detail": "Rebuilds the native app and installs it on the emulator or your phone. Needed after icon or package changes.",
      "type": "shell",
      "command": ".\\build-android.bat",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        },
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start app",
      "detail": "Starts the app server. Open Spelling Arcade on the phone or emulator. Press r in the terminal to reload, j for the debugger.",
      "type": "shell",
      "command": "npx expo start --dev-client",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    {
      "label": "Start app on Android",
      "detail": "Starts the app server and opens the app on the running emulator or connected phone.",
      "type": "shell",
      "command": "npx expo start --dev-client --android",
      "isBackground": true,
      "problemMatcher": [],
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    {
      "label": "Run tests",
      "detail": "Checks the app's rules (practice, review, backups, scanning).",
      "type": "shell",
      "command": "npm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    {
      "label": "Check types",
      "detail": "Looks for code mistakes TypeScript can catch.",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": "$tsc",
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    {
      "label": "Pack games",
      "detail": "Run after editing games-web/games.js so the app picks up the change.",
      "type": "shell",
      "command": "npm run pack-games",
      "problemMatcher": [],
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    {
      "label": "Save build log",
      "detail": "Re-runs the Android build and saves the output to build-log.txt (for Claude to read).",
      "type": "shell",
      "command": ".\\build-log.bat",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": [
            "/d",
            "/c"
          ]
        },
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Security audit",
      "detail": "Checks the app's packages for known security problems (needs internet).",
      "type": "shell",
      "command": "npm audit --omit=dev",
      "problemMatcher": [],
      "options": {
        "env": {
          "ANDROID_HOME": "${env:LOCALAPPDATA}\\Android\\Sdk",
          "PATH": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools;${env:LOCALAPPDATA}\\Android\\Sdk\\emulator;${env:PATH}"
        }
      }
    },
    // ---------- iOS (cloud builds through Expo, since iPhone apps can't be built on Windows) ----------
    {
      "label": "iOS: Start for Expo Go (free, no Apple account)",
      "detail": "Quick testing on an iPhone with the free Expo Go app: scan the QR code with the iPhone camera (same Wi-Fi). Scanning lists is off in Expo Go",
      "type": "shell", "command": "npx expo start --go", "isBackground": true, "problemMatcher": []
    },
    {
      "label": "iOS 1: Sign in to Expo",
      "detail": "One time: sign in to your free Expo account (create one at expo.dev)",
      "type": "shell", "command": "npx eas-cli login", "problemMatcher": []
    },
    {
      "label": "iOS 2: Register a test iPhone or iPad",
      "detail": "Shows a link/QR code. Open it on each iPhone or iPad you want to test on",
      "type": "shell", "command": "npx eas-cli device:create", "problemMatcher": []
    },
    {
      "label": "iOS 3: Build test app for registered devices",
      "detail": "Cloud build (about 15 to 25 min). Gives an install link/QR. Runs on its own, no PC needed",
      "type": "shell", "command": "npx eas-cli build --platform ios --profile preview", "problemMatcher": []
    },
    {
      "label": "Android: Build test app (install link for any phone)",
      "detail": "Cloud build (about 10 to 20 min). Gives a link/QR to download and install the app on any Android phone",
      "type": "shell", "command": "npx eas-cli build --platform android --profile preview", "problemMatcher": []
    },
    {
      "label": "iOS: Build developer app (live reload from this PC)",
      "detail": "For live editing: the iPhone loads code from Metro on this PC over the same Wi-Fi",
      "type": "shell", "command": "npx eas-cli build --platform ios --profile development", "problemMatcher": []
    },
    {
      "label": "iOS: Start Metro for the iPhone developer app",
      "detail": "Then scan the QR code with the iPhone camera",
      "type": "shell", "command": "npx expo start --dev-client", "isBackground": true, "problemMatcher": []
    },
    {
      "label": "iOS: TestFlight build and upload",
      "detail": "For many testers: builds and uploads to TestFlight (needs the app created in App Store Connect)",
      "type": "shell", "command": "npx eas-cli build --platform ios --profile production --auto-submit", "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "pairAddress",
      "type": "promptString",
      "description": "Pairing address from the phone's 'Pair device with pairing code' screen (for example 192.168.1.42:37123)"
    },
    {
      "id": "pairCode",
      "type": "promptString",
      "description": "6-digit Wi-Fi pairing code shown on the phone"
    },
    {
      "id": "connectAddress",
      "type": "promptString",
      "description": "IP address & Port from the top of the phone's Wireless debugging screen (for example 192.168.1.42:41567)"
    }
  ]
}