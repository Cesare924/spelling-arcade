{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "ios": {
        "image": "sdk-58"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SHOW_SUPPORT_LINK": "true",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "sdk-58"
      }
    },
    "production": {
      "env": {
        "SHOW_SUPPORT_LINK": "false",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "autoIncrement": true,
      "ios": {
        "image": "sdk-58"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
